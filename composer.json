{
    "name": "fiber-interop/dbal",
    "description": "Doctrine DBAL drivers that run queries through fiber-interop/mysqli and fiber-interop/pg: cooperative DBAL queries inside async\\run() with one line of configuration.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "doctrine/dbal": "^3.8 || ^4.0",
        "fiber-interop/api": "^0.2",
        "fiber-interop/mysqli": "^0.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11",
        "fiber-interop/revolt": "*",
        "fiber-interop/amp": "*",
        "fiber-interop/react": "*",
        "fiber-interop/phasync": "*",
        "fiber-interop/swoole": "*"
    },
    "autoload": {
        "psr-4": {
            "async\\dbal\\": "src/"
        },
        "files": [
            "src/functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "async\\dbal\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.2.x-dev"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "path",
            "url": "../mysqli",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../api",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../scope",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../revolt",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../amp",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../react",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../phasync",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../swoole",
            "options": {
                "symlink": true
            }
        }
    ],
    "suggest": {
        "ext-mysqli": "for async\\dbal\\Mysqli\\Driver (DBAL 4) / async\\dbal\\V3\\Mysqli\\Driver (DBAL 3)",
        "ext-pgsql": "for async\\dbal\\PgSQL\\Driver (DBAL 4) / async\\dbal\\V3\\PgSQL\\Driver (DBAL 3)"
    }
}
